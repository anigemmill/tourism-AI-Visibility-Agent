# Database (docker-compose provides a matching local Postgres instance)
DATABASE_URL="postgresql://tourism:tourism@localhost:5432/tourism_ai_visibility"

# --- Auth --------------------------------------------------------------------
# Signs session cookies. Generate one with `openssl rand -base64 32`. Required.
AUTH_SECRET=

# --- Scheduled runs ------------------------------------------------------------
# Shared secret the daily cron endpoint checks for (Authorization: Bearer <secret>).
# See README "Scheduled runs" for wiring this up with Vercel Cron / GitHub Actions.
CRON_SECRET=

# --- Rate limiting / cost control --------------------------------------------
# Minimum minutes between pipeline/monitoring runs for the same business.
PIPELINE_COOLDOWN_MINUTES=15
# Max real (non-demo) AI/search calls per business per rolling 24h.
MAX_DISCOVERY_RESULTS_PER_DAY_PER_BUSINESS=500
# Max concurrent AI platform calls in flight during a monitoring run.
MONITORING_CONCURRENCY=4

# --- AI platform connectors -------------------------------------------------
# All are optional. Any platform whose key is absent runs in demo mode:
# results are clearly labeled `isDemoData: true` and are never presented as
# live findings. Add a key and that platform goes live with no code changes.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Google "AI Overview" / AI Mode results are not offered as a direct API by
# Google. The Google connector goes live via a SERP-scraping provider such as
# SerpApi (https://serpapi.com) that surfaces the AI Overview panel.
SERPAPI_API_KEY=

# Used by the crawler / content generator for LLM-assisted extraction and
# copy drafting. Defaults to ANTHROPIC_API_KEY if unset.
CONTENT_LLM_API_KEY=

# --- Review platform connectors ----------------------------------------------
# Optional. Without these, the Reputation tab's ratings are demo data
# (isDemoData: true), same fallback contract as the AI connectors.
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=
